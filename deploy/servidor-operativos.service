[Unit]
Description=Servidor de monitorización y ejecución remota de comandos
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/servidor-operativos
ExecStart=/usr/local/bin/servidor-operativos -config /etc/configProyecto.conf
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=mixed

# systemd crea y da permisos a estos directorios antes de iniciar el proceso.
# El log vive dentro de LogsDirectory para que la rotación funcione con systemd.
StateDirectory=servidor-operativos
StateDirectoryMode=0750
LogsDirectory=proyecto-operativos
LogsDirectoryMode=0750

StandardOutput=journal
StandardError=journal
SyslogIdentifier=servidor-operativos

# El daemon necesita root para useradd y para cambiar UID/GID antes del exec de
# cada shell. Los comandos heredan la identidad autenticada, no la del daemon.
# ProtectSystem=full conserva /usr y /boot en solo lectura y deja que
# useradd actualice /etc y sus archivos auxiliares de /var.
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_FSETID CAP_KILL
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
