[Unit]
Description=Servidor de monitorización y ejecución remota de comandos
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=operativos
Group=operativos
WorkingDirectory=/var/lib/servidor-operativos
ExecStart=/usr/local/bin/servidor-operativos -config /etc/configProyecto.conf
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=mixed

# systemd crea y da permisos a estos directorios antes de iniciar el proceso.
# El log vive dentro de LogsDirectory para que la rotación funcione aunque
# ProtectSystem=strict deje el resto de /var en solo lectura.
StateDirectory=servidor-operativos
StateDirectoryMode=0750
LogsDirectory=proyecto-operativos
LogsDirectoryMode=0750

# El registro de cuentas desde la GUI agrega líneas al archivo de usuarios.
# ProtectSystem=strict hace de solo lectura el resto de /etc, por lo que este
# archivo se excluye explícitamente y se instala como root:operativos 0660.
ReadWritePaths=/etc/configProyecto.users

StandardOutput=journal
StandardError=journal
SyslogIdentifier=servidor-operativos

# Endurecimiento básico. El servidor ejecuta comandos remotos, por lo que se
# limita a un usuario sin privilegios y sin capacidades.
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
